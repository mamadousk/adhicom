@model Adhicom.Web.ViewModels.PlanFormViewModel
@{ ViewData["Title"] = (Model.Id is null ? "Nouveau plan" : "Modifier le plan") + " — Administration"; }
<div class="page-head"><div><p class="breadcrumb"><a href="/admin/plans">Plans</a> / @(Model.Id is null ? "Nouveau" : "Modifier")</p><h1>@(Model.Id is null ? "Nouveau plan" : $"Modifier « {Model.Name} »")</h1></div></div>
<form method="post" action="@(Model.Id is null ? "/admin/plans/create" : $"/admin/plans/edit/{Model.Id}")" class="card" style="max-width:760px">
    @Html.AntiForgeryToken()
    @if (Model.Id is not null) { <input type="hidden" asp-for="Id" /> }
    @if (!ViewContext.ModelState.IsValid) { <div class="validation-summary"><div asp-validation-summary="All"></div></div> }
    <div class="form-grid">
        <div class="form-group"><label asp-for="Key"></label><input asp-for="Key" type="text" placeholder="starter" @(Model.Id is not null ? "readonly" : "") /><span class="field-error" asp-validation-for="Key"></span><p class="form-hint">Identifiant technique stable, ex. free, starter, pro, business.</p></div>
        <div class="form-group"><label asp-for="Name"></label><input asp-for="Name" type="text" /><span class="field-error" asp-validation-for="Name"></span></div>
        <div class="form-group full"><label asp-for="Description"></label><input asp-for="Description" type="text" /></div>
        <div class="form-group"><label asp-for="MonthlyPrice"></label><input asp-for="MonthlyPrice" type="number" step="0.01" min="0" /></div>
        <div class="form-group"><label asp-for="Currency"></label><select asp-for="Currency"><option>USD</option><option>CDF</option><option>XAF</option><option>XOF</option></select></div>
        <div class="form-group"><label asp-for="SortOrder"></label><input asp-for="SortOrder" type="number" min="1" /></div>
        <div class="form-group"><label style="display:flex;gap:.5rem;align-items:center;font-weight:500"><input asp-for="IsActive" type="checkbox" style="width:auto" /> Plan actif</label></div>
        <div class="form-group"><label asp-for="MaxStores"></label><input asp-for="MaxStores" type="number" min="1" /></div>
        <div class="form-group"><label asp-for="MaxProducts"></label><input asp-for="MaxProducts" type="number" min="1" /></div>
        <div class="form-group"><label asp-for="MaxUsers"></label><input asp-for="MaxUsers" type="number" min="1" /></div>
        <div class="form-group"><label asp-for="MaxStorageMb"></label><input asp-for="MaxStorageMb" type="number" min="10" /></div>
        <div class="form-group full"><label>Options</label>
            <div style="display:flex;gap:1.2rem;flex-wrap:wrap">
                <label style="display:flex;gap:.4rem;align-items:center"><input asp-for="AllowPremiumThemes" type="checkbox" style="width:auto" /> Thèmes premium</label>
                <label style="display:flex;gap:.4rem;align-items:center"><input asp-for="AllowAdvancedAnalytics" type="checkbox" style="width:auto" /> Rapports avancés</label>
                <label style="display:flex;gap:.4rem;align-items:center"><input asp-for="AllowCoupons" type="checkbox" style="width:auto" /> Coupons</label>
                <label style="display:flex;gap:.4rem;align-items:center"><input asp-for="AllowMarketing" type="checkbox" style="width:auto" /> Marketing</label>
                <label style="display:flex;gap:.4rem;align-items:center"><input asp-for="AllowExports" type="checkbox" style="width:auto" /> Exports</label>
                <label style="display:flex;gap:.4rem;align-items:center"><input asp-for="AllowCustomDomain" type="checkbox" style="width:auto" /> Domaine perso</label>
            </div>
        </div>
    </div>
    <button class="btn btn-primary" type="submit">@(Model.Id is null ? "Créer le plan" : "Enregistrer")</button>
</form>
