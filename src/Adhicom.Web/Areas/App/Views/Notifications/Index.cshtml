@model IReadOnlyList<Adhicom.Domain.Notifications.Notification>
@{ ViewData["Title"] = "Notifications — Adhicom"; }
<div class="page-head">
    <div><p class="breadcrumb"><a href="/app">Tableau de bord</a> / Notifications</p><h1>Notifications <span class="muted">(@Model.Count)</span></h1></div>
    @if (Model.Any(n => n.ReadAtUtc is null))
    {
        <form method="post" action="/app/notifications/markallread">@Html.AntiForgeryToken()<button class="btn btn-outline btn-sm" type="submit">Tout marquer comme lu</button></form>
    }
</div>
@if (Model.Count == 0)
{
    <div class="empty-state card"><p>Aucune notification pour l'instant.</p></div>
}
else
{
    <div class="card" style="padding:0;overflow:hidden">
        @foreach (var n in Model)
        {
            var unread = n.ReadAtUtc is null;
            <form method="post" action="/app/notifications/open/@n.Id" style="display:flex;gap:.8rem;align-items:flex-start;padding:.75rem 1rem;border-bottom:1px solid var(--line);background:@(unread ? "#f7faf4" : "transparent")">
                @Html.AntiForgeryToken()
                <span style="font-size:1.15rem;line-height:1.4">@(n.Type switch { "order" => "🛍️", "stock" => "📦", "subscription" => "💳", "system" => "🔧", _ => "🔔" })</span>
                <span style="flex:1;min-width:0">
                    <strong>@n.Title</strong>@(unread ? " •" : "")<br />
                    <span class="small">@n.Body</span><br />
                    <span class="small muted">@n.CreatedAtUtc.ToString("dd/MM/yyyy HH:mm") UTC</span>
                </span>
                <button class="btn btn-ghost btn-sm" type="submit">@(n.Link is null ? "✓ Lu" : "Voir →")</button>
            </form>
        }
    </div>
}
