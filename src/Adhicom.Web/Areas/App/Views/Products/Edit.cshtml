@model Adhicom.Web.ViewModels.ProductFormViewModel
@{ ViewData["Title"] = "Modifier le produit — Adhicom"; var categories = ViewData["Categories"] as SelectList; var images = ViewData["Images"] as List<Adhicom.Domain.Catalog.ProductImage> ?? new(); }
<div class="page-head"><div><p class="breadcrumb"><a href="/app/products">Produits</a> / Modifier</p><h1>Modifier le produit</h1></div></div>
<form method="post" enctype="multipart/form-data" class="card">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    @if (!ViewContext.ModelState.IsValid) { <div class="validation-summary"><div asp-validation-summary="All"></div></div> }
    <div class="form-grid">
        <div class="form-group full"><label asp-for="Name"></label><input asp-for="Name" type="text" /><span class="field-error" asp-validation-for="Name"></span></div>
        <div class="form-group full"><label asp-for="Description"></label><textarea asp-for="Description" rows="3"></textarea></div>
        <div class="form-group"><label asp-for="Price"></label><input asp-for="Price" type="number" step="0.01" min="0" /></div>
        <div class="form-group"><label asp-for="CompareAtPrice"></label><input asp-for="CompareAtPrice" type="number" step="0.01" min="0" /><span class="field-error" asp-validation-for="CompareAtPrice"></span></div>
        <div class="form-group"><label asp-for="Sku"></label><input asp-for="Sku" type="text" /></div>
        <div class="form-group"><label asp-for="CategoryId"></label><select asp-for="CategoryId" asp-items="categories"><option value="">— Sans catégorie —</option></select></div>
        <div class="form-group"><label asp-for="StockQuantity"></label><input asp-for="StockQuantity" type="number" min="0" /></div>
        <div class="form-group"><label asp-for="WeightKg"></label><input asp-for="WeightKg" type="number" step="0.01" min="0" /></div>
        <div class="form-group"><label asp-for="Status"></label><select asp-for="Status"><option value="Active">Publié (visible)</option><option value="Draft">Brouillon (masqué)</option><option value="Archived">Archivé</option></select></div>
        <div class="form-group full"><label for="images">Ajouter des photos</label><input id="images" name="images" type="file" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" multiple /></div>
    </div>
    @if (images.Count > 0)
    {
        <div class="form-group full">
            <label>Photos actuelles</label>
            <div style="display:flex;gap:.6rem;flex-wrap:wrap">
                @foreach (var img in images)
                {
                    <div style="text-align:center">
                        <img src="@img.Url" alt="Photo produit" style="width:86px;height:86px;object-fit:cover;border-radius:12px;border:2px solid @(img.IsPrimary ? "var(--accent)" : "transparent")" />
                        <div style="display:flex;gap:.3rem;margin-top:.3rem">
                            <form method="post" action="/app/products/setprimaryimage" class="inline-form">@Html.AntiForgeryToken()<input type="hidden" name="productId" value="@Model.Id" /><input type="hidden" name="imageId" value="@img.Id" /><button class="btn btn-ghost btn-sm" type="submit" title="Définir comme photo principale">★</button></form>
                            <form method="post" action="/app/products/deleteimage" class="inline-form" data-confirm="Supprimer cette photo ?">@Html.AntiForgeryToken()<input type="hidden" name="productId" value="@Model.Id" /><input type="hidden" name="imageId" value="@img.Id" /><button class="btn btn-ghost btn-sm" type="submit">🗑</button></form>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    <button class="btn btn-primary" type="submit">Enregistrer les modifications</button>
</form>
