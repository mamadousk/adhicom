@model List<Adhicom.Domain.Catalog.Product>
@{
    ViewData["Title"] = "Produits — Adhicom";
    var query = ViewData["Query"] as string;
    var status = ViewData["Status"] as string;
    var page = ViewData["Page"] as int? ?? 1;
    var totalPages = ViewData["TotalPages"] as int? ?? 1;
    var total = ViewData["Total"] as int? ?? 0;
    var lowThreshold = 5;
}
<div class="page-head">
    <div><p class="breadcrumb"><a href="/app">Tableau de bord</a> / Produits</p><h1>Produits <span class="muted">(@total)</span></h1></div>
    <a class="btn btn-primary" href="/app/products/create">+ Ajouter un produit</a>
</div>
<form method="get" class="card card-flat" style="display:flex;gap:.6rem;flex-wrap:wrap;align-items:center;margin-bottom:1rem">
    <input type="search" name="q" value="@query" placeholder="Rechercher un produit, SKU..." style="max-width:280px" />
    <select name="status" data-auto-submit="1">
        <option value="">Tous (sauf archivés)</option>
        <option value="Active" selected="@(status == "Active" ? "selected" : null)">Publiés</option>
        <option value="Draft" selected="@(status == "Draft" ? "selected" : null)">Brouillons</option>
        <option value="Archived" selected="@(status == "Archived" ? "selected" : null)">Archivés</option>
    </select>
    <button class="btn btn-outline btn-sm" type="submit">Filtrer</button>
</form>
@if (Model.Count == 0)
{
    <div class="empty-state card"><p>Aucun produit trouvé.</p><a class="btn btn-accent" href="/app/products/create">Ajouter votre premier produit</a></div>
}
else
{
    <div class="table-wrap card" style="padding:0"><table class="table">
        <thead><tr><th>Photo</th><th>Produit</th><th>Prix</th><th>Stock</th><th>Statut</th><th></th></tr></thead>
        <tbody>
        @foreach (var p in Model)
        {
            var img = p.Images.OrderByDescending(i => i.IsPrimary).ThenBy(i => i.DisplayOrder).FirstOrDefault()?.Url;
            <tr>
                <td>@if (img is not null) { <img src="@img" alt="@p.Name" style="width:52px;height:52px;object-fit:cover;border-radius:10px" /> } else { <span class="avatar">@Ui.Initials(p.Name)</span> }</td>
                <td><strong>@p.Name</strong><br /><span class="small muted">@(p.Category?.Name ?? "Sans catégorie")@(p.Sku is null ? "" : $" · {p.Sku}")</span></td>
                <td>@Ui.Money(p.Price) @if (p.CompareAtPrice is { } cap) { <span class="small muted" style="text-decoration:line-through">@Ui.Money(cap)</span> }</td>
                <td>@if (p.StockQuantity <= 0) { <span class="badge badge-danger">Rupture</span> } else if (p.StockQuantity <= lowThreshold) { <span class="badge badge-warn">@p.StockQuantity (faible)</span> } else { <span class="badge badge-ok">@p.StockQuantity</span> }</td>
                <td><span class="badge @(p.Status == ProductStatus.Active ? "badge-ok" : p.Status == ProductStatus.Draft ? "badge-neutral" : "badge-warn")">@Ui.ProductStatus(p.Status)</span></td>
                <td style="white-space:nowrap">
                    <a class="btn btn-ghost btn-sm" href="/app/products/edit/@p.Id">Modifier</a>
                    <form class="inline-form" method="post" action="/app/products/togglepublish/@p.Id">@Html.AntiForgeryToken()<button class="btn btn-ghost btn-sm" type="submit">@(p.Status == ProductStatus.Active ? "Dépublier" : "Publier")</button></form>
                    <form class="inline-form" method="post" action="/app/products/archive/@p.Id" data-confirm="Archiver ce produit ? Il n'apparaîtra plus sur votre boutique.">@Html.AntiForgeryToken()<button class="btn btn-ghost btn-sm" type="submit">Archiver</button></form>
                </td>
            </tr>
        }
        </tbody>
    </table></div>
    @if (totalPages > 1)
    {
        <ul class="pagination">
            @for (var i = 1; i <= totalPages; i++)
            {
                <li class="@(i == page ? "active" : "")"><a href="/app/products?page=@i&q=@query&status=@status">@i</a></li>
            }
        </ul>
    }
}
