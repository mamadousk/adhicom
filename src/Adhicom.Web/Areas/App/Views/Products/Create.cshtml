@model Adhicom.Web.ViewModels.ProductFormViewModel
@{ ViewData["Title"] = "Ajouter un produit — Adhicom"; var categories = ViewData["Categories"] as SelectList; }
<div class="page-head"><div><p class="breadcrumb"><a href="/app/products">Produits</a> / Nouveau</p><h1>Nouveau produit</h1></div></div>
<form method="post" enctype="multipart/form-data" class="card">
    @Html.AntiForgeryToken()
    @if (!ViewContext.ModelState.IsValid) { <div class="validation-summary"><div asp-validation-summary="All"></div></div> }
    <div class="form-grid">
        <div class="form-group full"><label asp-for="Name"></label><input asp-for="Name" type="text" autofocus /><span class="field-error" asp-validation-for="Name"></span></div>
        <div class="form-group full"><label asp-for="Description"></label><textarea asp-for="Description" rows="3"></textarea></div>
        <div class="form-group"><label asp-for="Price"></label><input asp-for="Price" type="number" step="0.01" min="0" /><span class="field-error" asp-validation-for="Price"></span></div>
        <div class="form-group"><label asp-for="CompareAtPrice"></label><input asp-for="CompareAtPrice" type="number" step="0.01" min="0" placeholder="Prix barré (optionnel)" /><span class="field-error" asp-validation-for="CompareAtPrice"></span></div>
        <div class="form-group"><label asp-for="Sku"></label><input asp-for="Sku" type="text" /></div>
        <div class="form-group"><label asp-for="CategoryId"></label><select asp-for="CategoryId" asp-items="categories"><option value="">— Sans catégorie —</option></select></div>
        <div class="form-group"><label asp-for="StockQuantity"></label><input asp-for="StockQuantity" type="number" min="0" /></div>
        <div class="form-group"><label asp-for="WeightKg"></label><input asp-for="WeightKg" type="number" step="0.01" min="0" /></div>
        <div class="form-group"><label asp-for="Status"></label><select asp-for="Status"><option value="Active">Publié (visible)</option><option value="Draft">Brouillon (masqué)</option></select></div>
        <div class="form-group full"><label for="images">Photos (JPEG, PNG, WebP — 4 Mo max., 8 max.)</label><input id="images" name="images" type="file" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" multiple /></div>
    </div>
    <button class="btn btn-accent" type="submit">Créer le produit →</button>
</form>
