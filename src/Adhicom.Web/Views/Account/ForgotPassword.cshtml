@model Adhicom.Web.ViewModels.ForgotPasswordViewModel
@{ ViewData["Title"] = "Mot de passe oublié — Adhicom"; var submitted = ViewData["Submitted"] as bool? ?? false; var devLink = ViewData["DevResetLink"] as string; }
<section class="section"><div class="container-narrow" style="max-width:480px">
    <h1>Mot de passe oublié ?</h1>
    @if (submitted)
    {
        <div class="alert alert-ok">Si un compte existe pour cette adresse, un e-mail de réinitialisation vient d'être envoyé. Vérifiez votre boîte de réception.</div>
        @if (!string.IsNullOrEmpty(devLink))
        {
            <div class="alert alert-info small">Lien de développement : <a href="@devLink">@devLink</a></div>
        }
        <p><a class="btn btn-outline" href="/account/login">Retour à la connexion</a></p>
    }
    else
    {
        <p class="muted">Entrez votre adresse e-mail et nous vous enverrons un lien de réinitialisation.</p>
        <form method="post" class="card">@Html.AntiForgeryToken()
            @if (!ViewContext.ModelState.IsValid) { <div class="validation-summary"><div asp-validation-summary="All"></div></div> }
            <div class="form-group"><label asp-for="Email"></label><input asp-for="Email" type="email" autocomplete="email" autofocus /><span class="field-error" asp-validation-for="Email"></span></div>
            <button class="btn btn-primary btn-block" type="submit">Envoyer le lien</button>
        </form>
    }
</div></section>
