@model Adhicom.Web.ViewModels.ResetPasswordViewModel
@{ ViewData["Title"] = "Réinitialiser le mot de passe — Adhicom"; }
<section class="section"><div class="container-narrow" style="max-width:480px">
    <h1>Nouveau mot de passe</h1>
    <form method="post" class="card">@Html.AntiForgeryToken()
        <input type="hidden" asp-for="Email" />
        <input type="hidden" asp-for="Token" />
        @if (!ViewContext.ModelState.IsValid) { <div class="validation-summary"><div asp-validation-summary="All"></div></div> }
        <div class="form-group"><label asp-for="Password"></label><input asp-for="Password" type="password" autocomplete="new-password" autofocus /><span class="field-error" asp-validation-for="Password"></span></div>
        <div class="form-group"><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" type="password" autocomplete="new-password" /><span class="field-error" asp-validation-for="ConfirmPassword"></span></div>
        <button class="btn btn-primary btn-block" type="submit">Réinitialiser</button>
    </form>
</div></section>
