@model Adhicom.Web.ViewModels.RegisterViewModel
@{ ViewData["Title"] = "Créer votre compte — Adhicom"; }
<section class="section">
    <div class="container-narrow" style="max-width:560px">
        <div style="text-align:center;margin-bottom:1.5rem">
            <a class="logo" href="/" style="justify-content:center"><span class="logo-mark">A</span><span>Adhicom</span></a>
            <h1 style="margin-top:1rem">Créez votre boutique</h1>
            <p class="muted">2 minutes. Aucune carte bancaire. Votre boutique en ligne ensuite.</p>
        </div>
        <form method="post" class="card">
            @Html.AntiForgeryToken()
            @if (!ViewContext.ModelState.IsValid) { <div class="validation-summary"><strong>Merci de corriger :</strong><div asp-validation-summary="All"></div></div> }
            <div class="form-grid">
                <div class="form-group"><label asp-for="FirstName"></label><input asp-for="FirstName" type="text" autocomplete="given-name" /><span class="field-error" asp-validation-for="FirstName"></span></div>
                <div class="form-group"><label asp-for="LastName"></label><input asp-for="LastName" type="text" autocomplete="family-name" /><span class="field-error" asp-validation-for="LastName"></span></div>
                <div class="form-group full"><label asp-for="Email"></label><input asp-for="Email" type="email" autocomplete="email" placeholder="vous@exemple.com" /><span class="field-error" asp-validation-for="Email"></span></div>
                <div class="form-group full"><label asp-for="Phone"></label><input asp-for="Phone" type="tel" autocomplete="tel" placeholder="+243 99 000 0000" /><span class="field-error" asp-validation-for="Phone"></span></div>
                <div class="form-group"><label asp-for="Password"></label><input asp-for="Password" type="password" autocomplete="new-password" placeholder="8+ caractères, 1 chiffre" /><span class="field-error" asp-validation-for="Password"></span></div>
                <div class="form-group"><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" type="password" autocomplete="new-password" /><span class="field-error" asp-validation-for="ConfirmPassword"></span></div>
            </div>
            <div class="form-group">
                <label style="display:flex;gap:.5rem;align-items:flex-start;font-weight:500">
                    <input asp-for="AcceptTerms" type="checkbox" style="width:auto;margin-top:.25rem" />
                    <span>@Html.DisplayNameFor(m => m.AcceptTerms) — <a href="/cgu">CGU</a> et <a href="/confidentialite">Politique de confidentialité</a>.</span>
                </label>
                <span class="field-error" asp-validation-for="AcceptTerms"></span>
            </div>
            <button class="btn btn-accent btn-block btn-lg" type="submit">Créer mon compte →</button>
        </form>
        <p class="small muted" style="text-align:center;margin-top:1rem">Déjà inscrit ? <a href="/account/login">Se connecter</a></p>
    </div>
</section>
