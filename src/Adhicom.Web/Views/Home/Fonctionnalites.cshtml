@{ ViewData["Title"] = "Fonctionnalités — Adhicom"; }
<section class="section">
    <div class="container">
        <div class="section-head">
            <p class="eyebrow">Fonctionnalités</p>
            <h1>Une plateforme complète pour votre commerce</h1>
            <p class="muted">Boucle complète : la boutique, la vente, le suivi — du catalogue à la livraison.</p>
        </div>
        <div class="feature-grid">
            <div class="feature-card"><div class="feature-icon">🎨</div><h3>Thèmes professionnels</h3><p class="small muted">Mode, sneakers, électronique, beauté, alimentation ou généraliste. Couleurs, logo, bannière — à votre image, sans code.</p></div>
            <div class="feature-card"><div class="feature-icon">📦</div><h3>Gestion des produits</h3><p class="small muted">Nom, prix, prix promo, SKU, photos (JPEG/PNG/WebP, 4 Mo max), variantes (taille, couleur), catégories et ordre d'affichage.</p></div>
            <div class="feature-card"><div class="feature-icon">📉</div><h3>Stocks maîtrisés</h3><p class="small muted">Décrément automatique à la commande ou à la confirmation (au choix), alerte de stock faible, historique des mouvements.</p></div>
            <div class="feature-card"><div class="feature-icon">🛒</div><h3>Panier &amp; commande mobile</h3><p class="small muted">Panier rapide sur smartphone, coordonnées, commune/quartier, instructions — adapté aux réalités de Kinshasa.</p></div>
            <div class="feature-card"><div class="feature-icon">💵</div><h3>Paiement à la livraison</h3><p class="small muted">Activé par défaut. Le client paie à la réception ; vous marquez la commande comme payée en un clic.</p></div>
            <div class="feature-card"><div class="feature-icon">📱</div><h3>Mobile Money avec preuve</h3><p class="small muted">Le client paie par M-Pesa, Airtel Money ou Orange Money et vous envoie la capture. Vous confirmez dans votre tableau de bord.</p></div>
            <div class="feature-card"><div class="feature-icon">💬</div><h3>Commandes WhatsApp</h3><p class="small muted">Deux modes : commande enregistrée + contact WhatsApp, ou redirection vers wa.me avec récapitulatif pré-rempli.</p></div>
            <div class="feature-card"><div class="feature-icon">🚚</div><h3>Livraison à votre façon</h3><p class="small muted">Zones, tarifs forfaitaires, livraison gratuite au-delà d'un montant, retrait sur place, délais indicatifs.</p></div>
            <div class="feature-card"><div class="feature-icon">👥</div><h3>Fichier clients</h3><p class="small muted">Liste, recherche, historique des commandes, montant total par client, export CSV (plan Starter et +).</p></div>
            <div class="feature-card"><div class="feature-icon">📊</div><h3>Statistiques</h3><p class="small muted">CA (payées/livrées), commandes du jour, en attente, produits en rupture, courbe de ventes sur 14 jours.</p></div>
            <div class="feature-card"><div class="feature-icon">🔎</div><h3>SEO boutique</h3><p class="small muted">Titres, descriptions, Open Graph et données structurées produits — vos produits remontent sur Google.</p></div>
            <div class="feature-card"><div class="feature-icon">🔒</div><h3>Sécurité &amp; isolation</h3><p class="small muted">Données cloisonnées par boutique (testées automatiquement), mots de passe hachés, HTTPS, rôles.</p></div>
        </div>
    </div>
</section>
